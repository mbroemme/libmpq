set -euo pipefail

compilers=(gcc clang)
standards=(c99 c11 c17 c23 gnu23)
if (($# != 0 && $# != 2)); then
	printf 'Usage: %s [gcc|clang c99|c11|c17|c23|gnu23]\n' "${0##*/}" >&2
	exit 2
fi
if (($# == 2)); then
	case "$1" in
		gcc|clang) compilers=("$1") ;;
		*) printf 'Unsupported compiler: %s\n' "$1" >&2; exit 2 ;;
	esac
	case "$2" in
		c99|c11|c17|c23|gnu23) standards=("$2") ;;
		*) printf 'Unsupported C standard: %s\n' "$2" >&2; exit 2 ;;
	esac
fi

readonly project_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
readonly temp_root="$(mktemp -d "${TMPDIR:-/tmp}/libmpq-c-standards.XXXXXX")"

cleanup()
{
	rm -rf "${temp_root}"
}
trap cleanup EXIT

cp -a "${project_root}" "${temp_root}/tree"
cd "${temp_root}/tree"

sh autogen.sh >/dev/null

for compiler in "${compilers[@]}"; do
	if ! command -v "${compiler}" >/dev/null 2>&1; then
		if (($# == 2)); then
			printf 'Required compiler not found: %s\n' "${compiler}" >&2
			exit 1
		fi
		printf 'Skipping unavailable compiler: %s\n' "${compiler}"
		continue
	fi

	for standard in "${standards[@]}"; do
		printf 'Compiling library and native regression programs: %s with %s...\n' "${standard}" "${compiler}"
		./configure --disable-static --enable-shared \
			CC="${compiler}" \
			CFLAGS="-O2 -g -std=${standard} -Wall -Wextra -Wpedantic -Werror" >/dev/null
		make clean >/dev/null 2>&1 || true
		make -j"$(nproc)" >/dev/null
		# Automake builds all check_PROGRAMS even with an empty TESTS list.
		# Keep standard compatibility separate from runtime regression coverage.
		make -j"$(nproc)" check TESTS= >/dev/null
	done
done

printf 'All requested C standard compilation checks passed (no native tests executed).\n'
