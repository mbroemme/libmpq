# it under the terms of the GNU Lesser General Public License as published
# by the Free Software Foundation; either version 2.1 of the License, or
# (at your option) any later version.

set -euo pipefail

readonly project_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${project_root}"

clang_format="${CLANG_FORMAT:-}"
if [[ -z "${clang_format}" ]]; then
	for candidate in clang-format-22 clang-format; do
		if command -v "${candidate}" >/dev/null 2>&1; then
			clang_format="${candidate}"
			break
		fi
	done
fi

if [[ -z "${clang_format}" ]] || ! command -v "${clang_format}" >/dev/null 2>&1; then
	printf 'No clang-format found. Set CLANG_FORMAT to its executable name or path.\n' >&2
	exit 1
fi

for command in git shellcheck; do
	if ! command -v "${command}" >/dev/null 2>&1; then
		printf 'Required command not found: %s\n' "${command}" >&2
		exit 1
	fi
done

printf 'Checking shell scripts...\n'
shell_scripts=(
	scripts/check
	scripts/check-comment-spacing
	scripts/check-function-spacing
	scripts/check-c-identifiers
	scripts/check-c-standards
	scripts/package-d-binary.sh
	scripts/package-native-binary.sh
	scripts/test-native-package.sh
	scripts/test-java-package.sh
	scripts/test-python-sdist.sh
)
sh -n autogen.sh
bash -n "${shell_scripts[@]}"
shellcheck -S error autogen.sh "${shell_scripts[@]}"

printf 'Checking tracked text whitespace...\n'
if git grep -nI '[[:blank:]]$' -- .; then
	printf 'Trailing whitespace found.\n' >&2
	exit 1
fi

printf 'Checking private native filename namespace...\n'
for source in src/*.c src/*.h; do
	if [[ "$(basename -- "${source}")" != mpq-* ]]; then
		printf 'Private native source/header is not namespaced: %s\n' "${source}" >&2
		exit 1
	fi
done

printf 'Checking C formatting...\n'
mapfile -t sources < <(
	git ls-files 'src/*.c' 'src/*.h' 'include/libmpq/*.h' 'tests/*.c' 'tests/*.h' |
	while IFS= read -r source; do
		if [[ -f "${source}" ]]; then
			printf '%s\n' "${source}"
		fi
	done
)
if ((${#sources[@]} == 0)); then
	printf 'No C sources found.\n' >&2
	exit 1
fi
scripts/check-comment-spacing "${sources[@]}"
scripts/check-function-spacing "${sources[@]}"
scripts/check-c-identifiers
scripts/check-c-standards
"${clang_format}" --dry-run --Werror "${sources[@]}"

printf 'All source checks passed.\n'
