.TH LIBMPQ__WRITER_WRITE 3 2026-08-18 "The MoPaQ archive library"
.SH NAME
libmpq__writer_write \- write bytes through an MPQ file writer
.SH SYNOPSIS
.nf
.B
#include <libmpq/mpq.h>
.sp
.BI "int32_t libmpq__writer_write("
.BI "        mpq_writer_s   *" "writer,"
.BI "        const uint8_t  *" "buffer,"
.BI "        libmpq__off_t   " "size"
.BI ");"
.fi
.SH DESCRIPTION
Appends bytes to the writer returned by libmpq__writer_begin(3). Writes beyond
the declared unpacked size are rejected.
.SH SEE ALSO
.BR libmpq__writer_begin (3),
.BR libmpq__writer_finish (3)
