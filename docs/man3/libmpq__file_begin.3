.TH LIBMPQ__FILE_BEGIN 3 2026-08-18 "The MoPaQ archive library"
.SH NAME
libmpq__file_begin \- begin a streamed MPQ file
.SH SYNOPSIS
.nf
.B
#include <libmpq/mpq.h>
.sp
.BI "int32_t libmpq__file_begin("
.BI "        mpq_archive_s  *" "archive,"
.BI "        const char     *" "name,"
.BI "        libmpq__off_t   " "size,"
.BI "        const mpq_file_options_s *" "options,"
.BI "        mpq_writer_s  **" "writer"
.BI ");"
.fi
.SH DESCRIPTION
Begins a file whose final unpacked size is known. Supply bytes with
libmpq__file_write(3), then call libmpq__file_finish(3).
.SH SEE ALSO
.BR libmpq__archive_create (3),
.BR libmpq__file_write (3),
.BR libmpq__file_finish (3),
.BR libmpq__file_add (3),
.BR libmpq__file_add_path (3)
