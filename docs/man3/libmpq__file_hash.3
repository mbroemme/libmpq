.TH LIBMPQ__FILE_HASH 3 2026-08-14 "The MoPaQ archive library"
.SH NAME
libmpq__file_hash \- calculate the Storm hashes for an MPQ filename.
.SH SYNOPSIS
.nf
.B #include <libmpq/mpq.h>
.sp
.BI "void libmpq__file_hash("
.BI "        const char *" "filename,"
.BI "        uint32_t *" "hash1,"
.BI "        uint32_t *" "hash2,"
.BI "        uint32_t *" "hash3"
.BI ");"
.fi
.SH DESCRIPTION
.PP
Call \fBlibmpq__file_hash\fP() to calculate the three Storm filename hashes
used by the classic MPQ hash table. The values can be reused with
\fBlibmpq__file_number_from_hash\fP() when looking up the same filename in
multiple archives.
.LP
The function stores the three hash values in \fIhash1\fP, \fIhash2\fP,
and \fIhash3\fP. All four pointers must be non-NULL. The filename must be a
valid NUL-terminated string, and each output must point to writable storage.
.SH EXAMPLE
.nf
/* Both archives have classic hashes. Read numbers only if both hits succeed. */
int32_t
lookup_classic_in_two_archives(
    mpq_archive_s *first, mpq_archive_s *second, uint32_t numbers[2]
)
{
    uint32_t start, a, b;
    libmpq__file_hash("data/sample.bin", &start, &a, &b);

    int32_t status = libmpq__file_number_from_hash(
        first, start, a, b, &numbers[0]
    );
    if (status != 0)
        return status;
    return libmpq__file_number_from_hash(second, start, a, b, &numbers[1]);
}
.fi
