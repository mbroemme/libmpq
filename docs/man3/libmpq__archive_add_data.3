.TH LIBMPQ__ARCHIVE_ADD_DATA 3 2026-08-18 "The MoPaQ archive library"
.SH NAME
libmpq__archive_add_data \- add an in-memory file to an MPQ archive
.SH SYNOPSIS
.nf
.B
#include <libmpq/mpq.h>
.sp
.BI "int32_t libmpq__archive_add_data("
.BI "        mpq_archive_s  *" "archive,"
.BI "        const char     *" "name,"
.BI "        const uint8_t  *" "buffer,"
.BI "        libmpq__off_t   " "size,"
.BI "        const mpq_file_options_s *" "options"
.BI ");"
.fi
.SH DESCRIPTION
Adds a complete memory buffer using the same options as the streaming writer.
.SH SEE ALSO
.BR libmpq__archive_create (3),
.BR libmpq__archive_add_path (3),
.BR libmpq__writer_begin (3)
